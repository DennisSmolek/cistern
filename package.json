{
    "name": "cistern",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.23.0",
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "build": "pnpm -r build",
        "dev": "pnpm -r --parallel --stream --filter @cistern/core --filter @cistern/camera --filter @cistern/r3f --filter apps-docs-astro dev",
        "dev:docs": "pnpm --filter apps-docs-astro dev",
        "dev:starter": "pnpm --filter @cistern/starter dev",
        "typecheck": "tsc -b",
        "test": "pnpm -r --if-present test",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "format": "prettier -w .",
        "changeset": "changeset",
        "release:version": "changeset version && pnpm install --no-frozen-lockfile",
        "release:publish": "pnpm -r build && pnpm publish -r --access public --no-git-checks && changeset git-tag && git push origin --tags"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.185.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-tsdoc": "^0.5.4",
        "prettier": "^3.9.9",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.2"
    }
}