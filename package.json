{
  "name": "cistern",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --stream --filter @cistern/core --filter @cistern/camera --filter @cistern/r3f --filter apps-docs-astro dev",
    "dev:studio": "pnpm --filter @cistern/studio dev",
    "dev:docs": "pnpm --filter @cistern/docs dev",
    "docs:api": "pnpm --filter @cistern/docs run build:api",
    "docs:build": "pnpm --filter @cistern/docs run build",
    "docs:preview": "pnpm --filter @cistern/docs run preview",
    "dev:starter": "pnpm --filter @cistern/starter dev",
    "dev:examples": "pnpm --filter @cistern/examples dev",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier -w .",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --no-frozen-lockfile",
    "release:publish": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-tsdoc": "^0.4.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitepress": "^1.6.4"
  }
}