{
    "name": "@cistern/camera",
    "version": "0.1.0",
    "description": "CisternCameraControls — camera-controls subclass with cistern-aware collision/boundaries for galleries in the round",
    "keywords": [
        "three",
        "threejs",
        "camera-controls",
        "camera",
        "gallery",
        "cistern"
    ],
    "license": "MIT",
    "homepage": "https://cistern.studio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DennisSmolek/cistern.git",
        "directory": "packages/camera"
    },
    "private": false,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup src/index.ts --dts --format esm,cjs --sourcemap --clean --tsconfig tsconfig.tsup.json",
        "dev": "tsup src/index.ts --dts --format esm,cjs --sourcemap --watch --tsconfig tsconfig.tsup.json"
    },
    "peerDependencies": {
        "three": ">=0.185.0",
        "camera-controls": "^3.1.0"
    },
    "dependencies": {
        "@cistern/core": "workspace:^"
    },
    "devDependencies": {
        "@cistern/types": "workspace:*",
        "camera-controls": "^3.1.2",
        "tsup": "^8.5.1",
        "typescript": "^5.9.2"
    }
}
