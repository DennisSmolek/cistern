{
    "name": "@cistern/r3f",
    "version": "0.1.0",
    "description": "React Three Fiber components for Cistern — <Cistern>, <CisternMesh>, <CisternCamera> galleries in the round",
    "keywords": [
        "react",
        "react-three-fiber",
        "r3f",
        "three",
        "webgpu",
        "gallery",
        "cistern"
    ],
    "license": "MIT",
    "homepage": "https://cistern.studio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DennisSmolek/cistern.git",
        "directory": "packages/r3f"
    },
    "private": false,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup src/index.ts --dts --format esm,cjs --sourcemap --clean --tsconfig tsconfig.tsup.json",
        "dev": "tsup src/index.ts --dts --format esm,cjs --sourcemap --watch --tsconfig tsconfig.tsup.json"
    },
    "dependencies": {
        "@cistern/camera": "workspace:^"
    },
    "peerDependencies": {
        "@cistern/core": "workspace:^",
        "@react-three/drei": "^10.7.6",
        "@react-three/fiber": "^9.0.0 || >=10.0.0-alpha.4 <11",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "three": ">=0.185.0"
    },
    "devDependencies": {
        "@cistern/types": "workspace:*",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "10.0.0-alpha.4",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    }
}
