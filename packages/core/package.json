{
    "name": "@cistern/core",
    "version": "0.1.0",
    "description": "Core geometry toolkit for galleries in the round — CisternGeometry (profile-revolution BufferGeometry with sectional attributes) and TSL/WebGPU CisternMaterial",
    "keywords": [
        "three",
        "threejs",
        "webgpu",
        "tsl",
        "geometry",
        "gallery",
        "lathe",
        "cistern"
    ],
    "license": "MIT",
    "homepage": "https://cistern.studio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DennisSmolek/cistern.git",
        "directory": "packages/core"
    },
    "private": false,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup src/index.ts --dts --format esm,cjs --sourcemap --clean --tsconfig tsconfig.tsup.json",
        "dev": "tsup src/index.ts --dts --format esm,cjs --sourcemap --watch --tsconfig tsconfig.tsup.json",
        "test": "vitest run"
    },
    "peerDependencies": {
        "three": ">=0.185.0"
    },
    "devDependencies": {
        "@cistern/types": "workspace:*",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    }
}
