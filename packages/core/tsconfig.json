{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "outDir": "dist-tsc",
        "rootDir": "src",
        "types": ["@types/three"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
    "exclude": ["src/**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
